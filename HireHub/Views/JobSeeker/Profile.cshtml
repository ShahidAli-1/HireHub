@model HireHub.ViewModels.Profiles.JobSeekerProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "_JobSeekerLayout";
}

<h1 class="page-title">My Profile</h1>
<p class="page-subtitle">Update your personal details and resume.</p>

<form asp-action="Profile" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-4">
        <!-- LEFT COLUMN: Details -->
        <div class="col-lg-8">
            <div class="section-card">
                <h5 class="mb-3">Basic Info</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label">Full Name *</label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label">Phone</label>
                        <input asp-for="Phone" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label">Location</label>
                        <input asp-for="Location" class="form-control" placeholder="e.g. Lahore, Pakistan" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ExpectedSalary" class="form-label">Expected Salary (Rs.)</label>
                        <input asp-for="ExpectedSalary" class="form-control" placeholder="e.g. 50,000 - 80,000" />
                        <span asp-validation-for="ExpectedSalary" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Bio" class="form-label">Professional Bio</label>
                        <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Brief summary about yourself..."></textarea>
                    </div>
                </div>
            </div>

            <div class="section-card">
                <h5 class="mb-3">Experience & Education</h5>
                <div class="mb-3">
                    <label asp-for="Skills" class="form-label">Skills (comma separated)</label>
                    <input asp-for="Skills" class="form-control" placeholder="e.g. C#, ASP.NET, SQL, JavaScript" />
                </div>
                <div class="mb-3">
                    <label asp-for="Experience" class="form-label">Work Experience</label>
                    <textarea asp-for="Experience" class="form-control" rows="4"></textarea>
                </div>
                <div class="mb-3">
                    <label asp-for="Education" class="form-label">Education</label>
                    <textarea asp-for="Education" class="form-control" rows="3"></textarea>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Resume & Save (Sticky) -->
        <div class="col-lg-4">
            <div style="position: sticky; top: 20px;">
                <div class="section-card">
                    <h5 class="mb-3">Resume</h5>
                    @if (!string.IsNullOrEmpty(Model.ExistingResumePath))
                    {
                        <div class="alert alert-success small py-2">
                            <i class="bi bi-file-earmark-pdf"></i> Resume uploaded
                        </div>
                        <a href="@Model.ExistingResumePath" target="_blank" class="btn btn-sm btn-outline-secondary w-100 mb-3">
                            <i class="bi bi-eye"></i> View Current Resume
                        </a>
                    }
                    else
                    {
                        <div class="alert alert-warning small py-2">
                            No resume uploaded yet.
                        </div>
                    }

                    <label asp-for="ResumeFile" class="form-label">Upload New Resume (PDF/DOCX)</label>
                    <input asp-for="ResumeFile" type="file" class="form-control mb-2" accept=".pdf,.doc,.docx" />
                    <span asp-validation-for="ResumeFile" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 shadow-sm">
                    <i class="bi bi-check-circle"></i> Save Profile
                </button>

            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}