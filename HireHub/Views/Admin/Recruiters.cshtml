@model HireHub.ViewModels.Admin.RecruitersListViewModel
@{
    ViewData["Title"] = "Verify Recruiters";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="admin-page-title">Verify Recruiters</h1>
        <p class="admin-page-subtitle">Approve company accounts to display the "Verified" badge.</p>
    </div>
    <div>
        <span class="badge bg-warning text-dark">Pending: @Model.PendingCount</span>
        <span class="badge bg-success">Verified: @Model.VerifiedCount</span>
    </div>
</div>

<div class="admin-section-card">
    @if (!Model.Recruiters.Any())
    {
        <div class="text-center text-muted py-5">No recruiters yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr class="text-muted small">
                        <th>Company</th>
                        <th>Contact</th>
                        <th>Industry</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Recruiters)
                    {
                        var profile = r.RecruiterProfile;
                        var isVerified = profile?.IsVerified == true;

                        <tr>
                            <td>
                                <div class="fw-semibold">@(profile?.CompanyName ?? "—")</div>
                                <div class="small text-muted">@r.FullName</div>
                            </td>
                            <td class="small">
                                <div>@r.Email</div>
                                <div class="text-muted">@r.Phone</div>
                            </td>
                            <td class="small text-muted">@(profile?.Industry ?? "—")</td>
                            <td>
                                @if (isVerified)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-patch-check-fill"></i> Verified
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-hourglass"></i> Pending
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                @if (isVerified)
                                {
                                    <form asp-action="UnverifyRecruiter" asp-route-id="@r.UserId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                onclick="return confirm('Remove verification?');">
                                            <i class="bi bi-x-circle"></i> Unverify
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="VerifyRecruiter" asp-route-id="@r.UserId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="bi bi-check-circle"></i> Verify
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>