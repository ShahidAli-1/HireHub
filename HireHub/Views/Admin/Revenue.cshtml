@model HireHub.ViewModels.Admin.RevenueReportViewModel
@{
    ViewData["Title"] = "Revenue Reports";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="admin-page-title">Revenue Reports</h1>
        <p class="admin-page-subtitle">Financial overview of HireHub.</p>
    </div>
    <a asp-action="ExportRevenue" class="btn btn-success">
        <i class="bi bi-download"></i> Export Revenue CSV
    </a>
</div>

<!-- ====== STAT CARDS ====== -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="admin-stat-card">
            <div class="stat-icon bg-green"><i class="bi bi-cash-stack"></i></div>
            <div>
                <div class="stat-value">Rs. @Model.TotalRevenue.ToString("N0")</div>
                <div class="stat-label">All-Time Revenue</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="admin-stat-card warning">
            <div class="stat-icon bg-amber"><i class="bi bi-graph-up-arrow"></i></div>
            <div>
                <div class="stat-value">Rs. @Model.MRR.ToString("N0")</div>
                <div class="stat-label">MRR (This Month)</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="admin-stat-card info">
            <div class="stat-icon bg-blue"><i class="bi bi-receipt"></i></div>
            <div>
                <div class="stat-value">@Model.TotalTransactions</div>
                <div class="stat-label">Transactions</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="admin-stat-card success">
            <div class="stat-icon bg-green"><i class="bi bi-person-check"></i></div>
            <div>
                <div class="stat-value">@Model.ActiveSubscriptions</div>
                <div class="stat-label">Active Subscriptions</div>
            </div>
        </div>
    </div>
</div>

<!-- ====== CHARTS ====== -->
<div class="row g-3 mb-4">
    <!-- Line chart: Monthly revenue -->
    <div class="col-lg-8">
        <div class="admin-section-card">
            <h5>Revenue Trend (Last 6 Months)</h5>
            <div style="position: relative; height: 300px;">
                <canvas id="revenueLineChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Doughnut: Plan distribution -->
    <div class="col-lg-4">
        <div class="admin-section-card">
            <h5>Active Plan Distribution</h5>
            @if (!Model.PlanDistribution.Any())
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-inbox" style="font-size:2rem;"></i>
                    <p class="mt-2 mb-0">No active subscriptions yet.</p>
                </div>
            }
            else
            {
                <div style="position: relative; height: 300px;">
                    <canvas id="planDoughnutChart"></canvas>
                </div>
            }
        </div>
    </div>
</div>

<!-- ====== REVENUE BY PLAN TABLE ====== -->
<div class="admin-section-card mb-4">
    <h5>Revenue by Plan</h5>
    @if (!Model.RevenueByPlan.Any())
    {
        <div class="text-center text-muted py-4">No subscription payments yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr class="text-muted small">
                        <th>Plan</th>
                        <th class="text-end">Revenue</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kv in Model.RevenueByPlan.OrderByDescending(kv => kv.Value))
                    {
                        <tr>
                            <td class="fw-semibold">@kv.Key</td>
                            <td class="text-end fw-bold text-success">Rs. @kv.Value.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ====== RECENT TRANSACTIONS ====== -->
<div class="admin-section-card">
    <h5>Recent Approved Payments</h5>
    @if (!Model.RecentTransactions.Any())
    {
        <div class="text-center text-muted py-4">No approved payments yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr class="text-muted small">
                        <th>Date</th>
                        <th>User</th>
                        <th>Purpose</th>
                        <th>Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.RecentTransactions)
                    {
                        <tr>
                            <td class="small text-muted">@p.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="fw-semibold">@p.User?.FullName</td>
                            <td class="small text-muted">@p.Purpose</td>
                            <td class="fw-bold text-success">Rs. @p.Amount.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <script>
        // ===== Line Chart: Monthly Revenue =====
        const monthLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthLabels));
        const monthlyRevenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenue));

        const lineCtx = document.getElementById('revenueLineChart');
        if (lineCtx) {
            new Chart(lineCtx, {
                type: 'line',
                data: {
                    labels: monthLabels,
                    datasets: [{
                        label: 'Revenue (Rs.)',
                        data: monthlyRevenue,
                        borderColor: '#16a34a',
                        backgroundColor: 'rgba(22, 163, 74, 0.1)',
                        fill: true,
                        tension: 0.35,
                        borderWidth: 3,
                        pointRadius: 5,
                        pointBackgroundColor: '#16a34a'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { callback: function(value) { return 'Rs. ' + value.toLocaleString(); } }
                        }
                    }
                }
            });
        }

        // ===== Doughnut Chart: Plan Distribution =====
        const planLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PlanDistribution.Keys.ToList()));
        const planData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PlanDistribution.Values.ToList()));

        const doughnutCtx = document.getElementById('planDoughnutChart');
        if (doughnutCtx) {
            new Chart(doughnutCtx, {
                type: 'doughnut',
                data: {
                    labels: planLabels,
                    datasets: [{
                        data: planData,
                        backgroundColor: ['#4f46e5', '#16a34a', '#dc2626', '#f59e0b', '#3b82f6', '#8b5cf6', '#ec4899'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { padding: 15, font: { size: 12 } } }
                    }
                }
            });
        }
    </script>
}