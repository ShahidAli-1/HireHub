@model HireHub.ViewModels.Admin.CreateAdminViewModel
@{
    ViewData["Title"] = "Create Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="admin-page-title">Create Admin</h1>
        <p class="admin-page-subtitle">Add a new administrator to the system.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Dashboard
    </a>
</div>

<div class="admin-section-card" style="max-width: 700px;">
    <form asp-action="CreateAdmin" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label">Full Name <span class="text-danger">*</span></label>
            <input asp-for="FullName" class="form-control" placeholder="e.g. Ayesha Khan" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
            <input asp-for="Email" class="form-control" placeholder="admin2@hirehub.pk" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Phone" class="form-label">Phone (optional)</label>
            <input asp-for="Phone" class="form-control" placeholder="+92 300 1234567" />
            <span asp-validation-for="Phone" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Initial Password <span class="text-danger">*</span></label>
            <input asp-for="Password" type="password" class="form-control"
                   placeholder="Minimum 6 characters" />
            <span asp-validation-for="Password" class="text-danger small"></span>
            <small class="text-muted d-block mt-1">
                Share this password securely — the new admin should change it after first login.
            </small>
        </div>

        <div class="alert alert-warning small">
            <i class="bi bi-shield-exclamation"></i>
            <strong>Warning:</strong> Admins have full access to all data. Only create accounts for trusted team members.
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-shield-plus"></i> Create Admin
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}