@model HireHub.ViewModels.Admin.CategoriesListViewModel
@{
    ViewData["Title"] = "Manage Categories";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="admin-page-title">Manage Categories</h1>
        <p class="admin-page-subtitle">Job categories used across the platform.</p>
    </div>
    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
        <i class="bi bi-plus-circle"></i> Add Category
    </button>
</div>

<div class="admin-section-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr class="text-muted small">
                    <th>Name</th>
                    <th>Icon</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Categories)
                {
                    <tr>
                        <td class="fw-semibold">@c.Name</td>
                        <td>
                            @if (!string.IsNullOrEmpty(c.Icon))
                            {
                                <i class="bi @c.Icon" style="font-size:1.2rem;"></i>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td class="small text-muted">@c.Description</td>
                        <td>
                            @if (c.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex gap-1 justify-content-end">
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal" data-bs-target="#editCategoryModal-@c.CategoryId">
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                                <form asp-action="ToggleCategoryActive" asp-route-id="@c.CategoryId"
                                      method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm @(c.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @if (c.IsActive)
                                        {
                                            <i class="bi bi-slash-circle"></i> <text>Disable</text>
                                        }
                                        else
                                        {
                                            <i class="bi bi-check-circle"></i> <text>Enable</text>
                                        }
                                    </button>
                                </form>
                            </div>

                            <!-- Edit Modal -->
                            <div class="modal fade" id="editCategoryModal-@c.CategoryId" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content text-start">
                                        <form asp-action="UpdateCategory" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="CategoryId" value="@c.CategoryId" />
                                            <div class="modal-header">
                                                <h5 class="modal-title">Edit Category</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label">Name</label>
                                                    <input name="Name" class="form-control" value="@c.Name" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Icon (Bootstrap Icons class)</label>
                                                    <input name="Icon" class="form-control" value="@c.Icon"
                                                           placeholder="e.g. bi-code-slash" />
                                                    <small class="text-muted">See: bootstrap-icons list</small>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Description</label>
                                                    <textarea name="Description" class="form-control" rows="2">@c.Description</textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-danger">Save</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Category Modal -->
<div class="modal fade" id="createCategoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Add Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input name="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Icon (Bootstrap Icons)</label>
                        <input name="Icon" class="form-control" placeholder="e.g. bi-code-slash" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="Description" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>