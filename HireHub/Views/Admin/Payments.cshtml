@model HireHub.ViewModels.Admin.PendingPaymentsViewModel
@{
    ViewData["Title"] = "Pending Payments";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="admin-page-title">Pending Payments</h1>
        <p class="admin-page-subtitle">
            Approve manual payments to activate user subscriptions.
        </p>
    </div>
    <div class="text-end">
        <div class="small text-muted">Total Pending</div>
        <h3 class="fw-bold mb-0 text-danger">Rs. @Model.TotalPending.ToString("N0")</h3>
    </div>
</div>

<div class="admin-section-card">
    @if (!Model.PendingPayments.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
            <h5 class="mt-3">All caught up!</h5>
            <p class="text-muted">No pending payments to review.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                 <thead>
                    <tr class="text-muted small">
                        <th>User</th>
                        <th>Purpose</th>
                        <th>Amount</th>
                        <th class="hide-mobile">Reference</th> <!-- HIDDEN -->
                        <th class="hide-mobile">Proof</th>     <!-- HIDDEN -->
                        <th class="hide-mobile">Submitted</th> <!-- HIDDEN -->
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.PendingPayments)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@p.User?.FullName</div>
                                <div class="small text-muted">@p.User?.Email</div>
                            </td>
                            <td class="small fw-semibold">@p.Purpose</td>
                            <td class="fw-bold text-success">Rs. @p.Amount.ToString("N0")</td>
                            <td class="small text-muted">@p.ReferenceNumber</td>
                            <td>
                                @if (!string.IsNullOrEmpty(p.ProofImagePath))
                                {
                                    <a href="@p.ProofImagePath" target="_blank" rel="noopener"
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-image"></i> View
                                    </a>
                                }
                                else
                                {
                                    <span class="small text-muted">—</span>
                                }
                            </td>
                            <td class="small text-muted">
                                @p.CreatedAt.ToString("MMM dd, HH:mm")
                            </td>
                            <td class="text-end">
                                <div class="d-flex gap-1 justify-content-end">
                                    <!-- Approve -->
                                    <form asp-action="ApprovePayment" asp-route-id="@p.PaymentId"
                                          method="post" class="d-inline"
                                          onsubmit="return confirm('Approve this payment? The user will be upgraded immediately.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="bi bi-check-circle"></i> Approve
                                        </button>
                                    </form>

                                    <!-- Reject (opens modal) -->
                                    <button type="button" class="btn btn-sm btn-danger"
                                            data-bs-toggle="modal" data-bs-target="#rejectModal-@p.PaymentId">
                                        <i class="bi bi-x-circle"></i> Reject
                                    </button>
                                </div>

                                <!-- Reject Modal -->
                                <div class="modal fade" id="rejectModal-@p.PaymentId" tabindex="-1">
                                    <div class="modal-dialog">
                                        <div class="modal-content text-start">
                                            <form asp-action="RejectPayment" asp-route-id="@p.PaymentId" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-header">
                                                    <h5 class="modal-title">Reject Payment</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="small text-muted">
                                                        Rejecting payment from <strong>@p.User?.FullName</strong>
                                                        for <strong>Rs. @p.Amount.ToString("N0")</strong>.
                                                    </p>
                                                    <label class="form-label fw-semibold">Reason for rejection</label>
                                                    <textarea name="reason" class="form-control" rows="3" required
                                                              placeholder="e.g. Reference number doesn't match our records."></textarea>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-danger">Confirm Reject</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>