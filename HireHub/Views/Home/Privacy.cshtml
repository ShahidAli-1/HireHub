@{
    ViewData["Title"] = "Privacy Policy";
    Layout = "_Layout";
}

<style>
    /* Modern Font */
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Merriweather:ital,wght@0,300;0,400;1,300&display=swap');

    .saas-privacy {
        font-family: 'Inter', sans-serif;
        background-color: #ffffff;
        color: #334155;
        padding-top: 80px;
        padding-bottom: 100px;
    }

    /* Elegant Header */
    .privacy-header {
        max-width: 800px;
        margin: 0 auto 60px auto;
        text-align: center;
    }

    .privacy-header h1 {
        font-size: 3.5rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: #0f172a;
        margin-bottom: 1rem;
    }

    .privacy-header p {
        font-size: 1.1rem;
        color: #64748b;
    }

    .privacy-header .badge-date {
        display: inline-block;
        background: #e0e7ff;
        color: #4f46e5;
        padding: 6px 16px;
        border-radius: 100px;
        font-weight: 600;
        font-size: 0.85rem;
        margin-bottom: 1.5rem;
    }

    /* Layout Grid */
    .privacy-layout {
        display: flex;
        gap: 4rem;
        max-width: 1100px;
        margin: 0 auto;
    }

    /* Sticky Sidebar */
    .privacy-nav {
        flex: 0 0 240px;
        position: sticky;
        top: 100px;
        align-self: flex-start;
    }

    .privacy-nav h6 {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #94a3b8;
        margin-bottom: 1rem;
        padding-left: 1rem;
    }

    .privacy-nav ul {
        list-style: none;
        padding: 0;
        margin: 0;
        border-left: 2px solid #e2e8f0;
    }

    .privacy-nav ul li a {
        display: block;
        padding: 0.5rem 1rem;
        color: #64748b;
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.2s;
        margin-left: -2px;
        border-left: 2px solid transparent;
    }

    .privacy-nav ul li a:hover {
        color: #0f172a;
    }

    .privacy-nav ul li a.active {
        color: #4f46e5;
        border-left-color: #4f46e5;
        font-weight: 600;
    }

    /* Main Content Typography */
    .privacy-body {
        flex: 1;
        max-width: 750px;
    }

    .privacy-body section {
        margin-bottom: 4rem;
        scroll-margin-top: 100px;
    }

    .privacy-body h2 {
        font-size: 1.75rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 1.5rem;
        letter-spacing: -0.02em;
    }

    .privacy-body p {
        font-size: 1.05rem;
        line-height: 1.8;
        color: #475569;
        margin-bottom: 1.5rem;
    }

    .privacy-body ul {
        padding-left: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .privacy-body li {
        font-size: 1.05rem;
        line-height: 1.8;
        color: #475569;
        margin-bottom: 0.75rem;
        position: relative;
    }

    .privacy-body li::before {
        content: '';
        position: absolute;
        left: -1.25rem;
        top: 0.6rem;
        width: 6px;
        height: 6px;
        background: #cbd5e1;
        border-radius: 50%;
    }

    .privacy-body strong {
        color: #0f172a;
        font-weight: 600;
    }

    /* Modern Info Cards (For Contact) */
    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .info-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.5rem;
    }

    .info-card .icon {
        width: 40px;
        height: 40px;
        background: #e0e7ff;
        color: #4f46e5;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        margin-bottom: 1rem;
    }

    .info-card h5 {
        font-size: 0.9rem;
        font-weight: 600;
        color: #64748b;
        margin-bottom: 0.25rem;
    }

    .info-card p {
        font-size: 1rem;
        font-weight: 600;
        color: #0f172a;
        margin-bottom: 0;
    }

    @@media (max-width: 992px) {
        .privacy-layout { flex-direction: column; gap: 2rem; }
        .privacy-nav { display: none; }
        .privacy-header h1 { font-size: 2.5rem; }
        .info-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="saas-privacy">
    <div class="container">
        
        <!-- Header -->
        <div class="privacy-header">
            <span class="badge-date"><i class="bi bi-shield-check"></i> Legal Document</span>
            <h1>Privacy Policy</h1>
            <p>How we collect, use, and protect your data on HireHub.</p>
            <p class="mt-2 text-muted small">Last updated: @DateTime.Now.ToString("MMMM dd, yyyy")</p>
        </div>

        <!-- Layout -->
        <div class="privacy-layout">
            
            <!-- Sidebar -->
            <aside class="privacy-nav">
                <h6>On this page</h6>
                <ul>
                    <li><a href="#information-collect" class="active">Information We Collect</a></li>
                    <li><a href="#use-information">How We Use It</a></li>
                    <li><a href="#disclosure">Disclosure</a></li>
                    <li><a href="#security">Security</a></li>
                    <li><a href="#contact">Contact Us</a></li>
                </ul>
            </aside>

            <!-- Content -->
            <main class="privacy-body">
                
                <section id="information-collect">
                    <h2>1. Information We Collect</h2>
                    <p>At HireHub, we believe in transparency. We collect information to provide better services to all our users. The types of information we collect depend on how you use our platform.</p>
                    <ul>
                        <li><strong>Personal Data:</strong> When you register as a Job Seeker or Recruiter, we collect your name, email address, phone number, and any resume or company details you provide.</li>
                        <li><strong>Usage Data:</strong> We automatically collect information on how our service is accessed and used, including your IP address, browser type, and pages visited.</li>
                        <li><strong>Payment Data:</strong> For premium subscriptions, we process payments securely. We do not store your raw credit card details on our servers.</li>
                    </ul>
                </section>

                <section id="use-information">
                    <h2>2. How We Use Your Information</h2>
                    <p>We use the information we collect to provide, maintain, and improve our services. Specifically, we use it to:</p>
                    <ul>
                        <li>Connect job seekers with the right recruiters and opportunities.</li>
                        <li>Process transactions and send related information, including confirmations and receipts.</li>
                        <li>Send you technical notices, updates, security alerts, and support messages.</li>
                        <li>Monitor and analyze trends, usage, and activities in connection with our services.</li>
                    </ul>
                </section>

                <section id="disclosure">
                    <h2>3. Disclosure of Your Information</h2>
                    <p>We do not sell your personal data. We only share information in the following circumstances:</p>
                    <ul>
                        <li><strong>With Recruiters:</strong> If you are a Job Seeker, your profile and resume are shared with Recruiters when you apply for a job.</li>
                        <li><strong>Service Providers:</strong> We may share data with trusted third parties who perform services for us, such as email delivery and payment processing.</li>
                        <li><strong>For Legal Reasons:</strong> We may disclose information if required by law or to protect the safety and rights of HireHub and its users.</li>
                    </ul>
                </section>

                <section id="security">
                    <h2>4. Security</h2>
                    <p>We take the security of your data seriously. We use industry-standard encryption and security measures to protect your personal information from unauthorized access, alteration, or destruction.</p>
                    <p>However, please note that no method of transmission over the Internet or method of electronic storage is 100% secure. While we strive to use commercially acceptable means to protect your data, we cannot guarantee its absolute security.</p>
                </section>

                <section id="contact">
                    <h2>5. Contact Us</h2>
                    <p>If you have any questions or concerns about this Privacy Policy or our data practices, please reach out to our dedicated privacy team.</p>
                    
                    <div class="info-grid">
                        <div class="info-card">
                            <div class="icon"><i class="bi bi-envelope"></i></div>
                            <h5>Email Us</h5>
                            <p>privacy@hirehub.pk</p>
                        </div>
                        <div class="info-card">
                            <div class="icon"><i class="bi bi-geo-alt"></i></div>
                            <h5>Visit Us</h5>
                            <p>123 Tech Avenue, Lahore</p>
                        </div>
                    </div>
                </section>

            </main>
        </div>
    </div>
</div>

<script>
    // Scroll Spy: Highlight active sidebar link
    document.addEventListener('DOMContentLoaded', function () {
        const sections = document.querySelectorAll('.privacy-body section');
        const navLinks = document.querySelectorAll('.privacy-nav a');

        function makeActive(link) {
            navLinks.forEach(l => l.classList.remove('active'));
            link.classList.add('active');
        }

        window.addEventListener('scroll', () => {
            let current = '';
            
            sections.forEach(section => {
                const sectionTop = section.offsetTop;
                if (window.scrollY >= sectionTop - 150) {
                    current = section.getAttribute('id');
                }
            });

            navLinks.forEach(link => {
                if (link.getAttribute('href') === '#' + current) {
                    makeActive(link);
                }
            });
        });
        
        // Trigger once on load in case user is scrolled down
        window.dispatchEvent(new Event('scroll'));
    });
</script>