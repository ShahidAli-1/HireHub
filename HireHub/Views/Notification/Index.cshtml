@model List<HireHub.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
    
    if (User.IsInRole("Admin"))
        Layout = "_AdminLayout";
    else if (User.IsInRole("Recruiter"))
        Layout = "_RecruiterLayout";
    else
        Layout = "_JobSeekerLayout";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="page-title">Notifications</h1>
        <p class="page-subtitle">Your recent activity and updates.</p>
    </div>
    
    @if (Model.Any())
    {
        <div class="d-flex gap-2">
            @if (Model.Any(n => !n.IsRead))
            {
                <form asp-action="MarkAllRead" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-check2-all"></i> Mark All Read
                    </button>
                </form>
            }
            
            <form asp-action="DeleteAll" method="post" onsubmit="return confirm('Are you sure you want to delete all notifications?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-trash"></i> Clear All
                </button>
            </form>
        </div>
    }
</div>

<div class="section-card">
    @if (!Model.Any())
    {
        <div class="empty-state text-center py-5">
            <i class="bi bi-bell-slash text-muted" style="font-size: 3rem;"></i>
            <p class="mt-3 text-muted">You have no notifications yet.</p>
        </div>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var n in Model)
            {
                <div class="list-group-item py-3 @(n.IsRead ? "" : "bg-light border-start border-4 border-primary")">
                    <div class="d-flex w-100 justify-content-between align-items-start">
                        <div class="ms-2 me-auto">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <h6 class="mb-0 fw-bold @(n.IsRead ? "text-muted" : "text-dark")">
                                    @n.Title
                                </h6>
                                @if (!n.IsRead)
                                {
                                    <span class="badge bg-primary rounded-pill" style="font-size:0.6rem;">NEW</span>
                                }
                            </div>
                            <p class="mb-1 small @(n.IsRead ? "text-muted" : "text-dark")">
                                @n.Message
                            </p>
                            <small class="text-muted">
                                <i class="bi bi-clock"></i> @n.CreatedAt.ToString("MMM dd, yyyy 'at' HH:mm")
                            </small>
                            
                            @if (!string.IsNullOrEmpty(n.Link))
                            {
                                <div class="mt-2">
                                    <a href="@n.Link" class="btn btn-sm btn-outline-primary">
                                        View Details <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            }
                        </div>
                        
                        <!-- ACTIONS (Mark Read & Delete) -->
                        <div class="d-flex gap-1 ms-3">
                            @if (!n.IsRead)
                            {
                                <form asp-action="MarkRead" asp-route-id="@n.NotificationId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-light border" title="Mark as read">
                                        <i class="bi bi-check2"></i>
                                    </button>
                                </form>
                            }
                            
                            <form asp-action="Delete" asp-route-id="@n.NotificationId" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-light border text-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>