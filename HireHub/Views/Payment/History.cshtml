@model List<HireHub.Models.Payment>
@{
    ViewData["Title"] = "Payment History";
    var isJobSeeker = User.IsInRole("JobSeeker");
    Layout = isJobSeeker ? "_JobSeekerLayout" : "_RecruiterLayout";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="page-title">Payment History</h1>
        <p class="page-subtitle">All your payment submissions and their status.</p>
    </div>
    <a asp-controller="Subscription" asp-action="Plans" class="btn btn-primary">
        <i class="bi bi-star"></i> View Plans
    </a>
</div>

<div class="section-card">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-receipt"></i>
            <p>No payments yet.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr class="text-muted small">
                        <th>Date</th>
                        <th>Purpose</th>
                        <th>Amount</th>
                        <th>Reference</th>
                        <th>Status</th>
                        <th class="text-end">Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="small text-muted">@p.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td class="fw-semibold">@p.Purpose</td>
                            <td class="fw-semibold">Rs. @p.Amount.ToString("N0")</td>
                            <td class="small text-muted">@p.ReferenceNumber</td>
                            <td>
                                @if (p.Status == "Approved")
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else if (p.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            <td class="small text-muted text-end">
                                @if (!string.IsNullOrEmpty(p.Notes))
                                {
                                    @p.Notes
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>