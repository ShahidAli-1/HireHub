@{
    ViewData["Title"] = "ATS Analysis Result";
    Layout = ViewData["Layout"]?.ToString() ?? "_Layout";
    
    int score = ViewBag.Score ?? 0;
    List<string> passed = ViewBag.Passed ?? new List<string>();
    List<string> failed = ViewBag.Failed ?? new List<string>();
    
    string colorClass = score >= 75 ? "success" : (score >= 50 ? "warning" : "danger");
}

<div class="container py-5" style="max-width: 800px;">
    
    <div class="card border-0 shadow-lg text-center mb-4">
        <div class="card-body p-5">
            <h3 class="fw-bold mb-4">Your General ATS Score</h3>
            
            <!-- Big Score Circle -->
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle border border-5 border-@colorClass mb-4" 
                 style="width: 150px; height: 150px;">
                <h1 class="display-3 fw-bold text-@colorClass mb-0">@score%</h1>
            </div>

            <h4 class="text-@colorClass fw-bold">
                @if(score >= 75) { <text>Excellent Resume!</text> }
                else if(score >= 50) { <text>Good, but needs some fixes.</text> }
                else { <text>Needs Work. Follow the checklist below.</text> }
            </h4>
            <p class="text-muted">This score evaluates your resume's formatting, readability, and core sections based on ATS standards.</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Passed Checks -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-success bg-opacity-10 text-success fw-bold py-3">
                    <i class="bi bi-check-circle-fill"></i> What You Did Right (@passed.Count)
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach(var item in passed) {
                            <li class="list-group-item px-0 text-success">
                                <i class="bi bi-check2 me-2"></i> @item
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Failed Checks -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-danger bg-opacity-10 text-danger fw-bold py-3">
                    <i class="bi bi-x-circle-fill"></i> Areas to Improve (@failed.Count)
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach(var item in failed) {
                            <li class="list-group-item px-0 text-danger">
                                <i class="bi bi-x me-2"></i> @item
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-5">
        <a asp-action="Index" class="btn btn-outline-primary">Check Another Resume</a>
    </div>
</div>