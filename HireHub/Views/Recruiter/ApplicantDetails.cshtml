@model HireHub.Models.Application
@{
    ViewData["Title"] = "Applicant Details";
    Layout = "_RecruiterLayout";

    var seeker = Model.JobSeeker;
    var profile = seeker?.JobSeekerProfile;
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="page-title">Applicant Details</h1>
        <p class="page-subtitle">Application for <strong>@Model.Job?.Title</strong></p>
    </div>
    <a asp-action="Applicants" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back to Applicants
    </a>
</div>

<div class="row g-3">
    <!-- LEFT: Candidate -->
    <div class="col-lg-4">
        <div class="section-card">
            <div class="text-center mb-3">
                <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center"
                     style="width:80px;height:80px;font-size:2rem;">
                    @(seeker?.FullName?.Substring(0, 1).ToUpper() ?? "?")
                </div>
                <h5 class="fw-bold mt-3 mb-1">@seeker?.FullName</h5>
                <p class="small text-muted mb-0">@seeker?.Email</p>
                @if (!string.IsNullOrEmpty(seeker?.Phone))
                {
                    <p class="small text-muted mb-0"><i class="bi bi-telephone"></i> @seeker.Phone</p>
                }
            </div>

            @if (!string.IsNullOrEmpty(profile?.Location))
            {
                <div class="mb-2 small"><i class="bi bi-geo-alt text-muted"></i> @profile.Location</div>
            }

            @if (!string.IsNullOrEmpty(profile?.Skills))
            {
                <hr />
                <h6 class="small fw-bold text-uppercase text-muted">Skills</h6>
                <div class="d-flex flex-wrap gap-1">
                    @foreach (var skill in profile.Skills.Split(',', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="badge bg-light text-dark border">@skill.Trim()</span>
                    }
                </div>
            }

                       @if (!string.IsNullOrEmpty(profile?.ExpectedSalary))
            {
                <hr />
                <h6 class="small fw-bold text-uppercase text-muted">Expected Salary</h6>
                <div class="text-success fw-semibold">Rs. @profile.ExpectedSalary</div>
            }

            @if (!string.IsNullOrEmpty(Model.ResumePath))
            {
                <hr />
                <a href="@Model.ResumePath" target="_blank" rel="noopener"
                   class="btn btn-outline-primary btn-sm w-100">
                    <i class="bi bi-file-earmark-pdf"></i> Download Resume
                </a>
            }
            else
            {
                <hr />
                <div class="alert alert-warning small mb-0">
                    <i class="bi bi-exclamation-triangle"></i> No resume uploaded
                </div>
            }
        </div>
    </div>

    <!-- RIGHT: Application -->
    <div class="col-lg-8">

        <!-- Status update -->
        <div class="section-card">
            <h5><i class="bi bi-flag"></i> Application Status</h5>

            <div class="d-flex align-items-center gap-3 mb-3">
                <span class="badge-soft @Model.Status.ToLower() fs-6">@Model.Status</span>
                <small class="text-muted">
                    @if (Model.StatusUpdatedAt.HasValue)
                    {
                        <text>Last updated @Model.StatusUpdatedAt.Value.ToString("MMM dd, yyyy HH:mm")</text>
                    }
                    else
                    {
                        <text>Applied on @Model.AppliedAt.ToString("MMM dd, yyyy")</text>
                    }
                </small>
            </div>

            <div class="row g-2 align-items-end">
                @Html.AntiForgeryToken() <!-- For AJAX -->
                
                <div class="col-md-4">
                    <label class="form-label small">Change status to</label>
                    <select id="statusDropdown" class="form-select form-select-sm">
                        @foreach (var s in new[] { "Applied", "Shortlisted", "Interview", "Offered", "Hired", "Rejected" })
                        {
                            if (Model.Status == s)
                            {
                                <option value="@s" selected>@s</option>
                            }
                            else
                            {
                                <option value="@s">@s</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-5">
                    <label class="form-label small">Internal notes (optional)</label>
                    <input type="text" id="notesInput" class="form-control form-control-sm"
                           value="@Model.RecruiterNotes" placeholder="e.g. Great communication skills" />
                </div>

                <div class="col-md-3">
                    <!-- Changed to type="button" to prevent normal submission -->
                    <button type="button" id="updateStatusBtn" class="btn btn-primary btn-sm w-100">
                        <i class="bi bi-check-circle"></i> Update
                    </button>
                </div>
            </div>
            
             @if (!string.IsNullOrEmpty(Model.InterviewDetails))
            {
                <div class="alert alert-info mt-3 mb-0" style="white-space: pre-line;">
                    <strong><i class="bi bi-calendar-event"></i> Interview Scheduled:</strong>
                    @Model.InterviewDetails.Replace(" | ", "\n")
                </div>
            }
        </div>

        <!-- Cover letter -->
        <div class="section-card">
            <h5><i class="bi bi-envelope-paper"></i> Cover Letter</h5>
            @if (string.IsNullOrEmpty(Model.CoverLetter))
            {
                <p class="text-muted mb-0">No cover letter provided.</p>
            }
            else
            {
                <div style="white-space: pre-wrap; line-height: 1.7;">@Model.CoverLetter</div>
            }
        </div>
    </div>
</div>

<!-- ================= MODALS & SCRIPTS ================= -->

<!-- Standard Status Update Form (Hidden, submitted via JS) -->
<form id="standardUpdateForm" asp-action="UpdateStatus" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="applicationId" value="@Model.ApplicationId" />
    <input type="hidden" name="status" id="hiddenStatus" />
    <input type="hidden" name="notes" id="hiddenNotes" />
</form>

<!-- Interview Modal -->
<div class="modal fade" id="interviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-camera-video"></i> Schedule Interview</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-4">Set the interview details. These will be emailed to the candidate.</p>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Date</label>
                    <input type="date" id="interviewDate" class="form-control" min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Time</label>
                    <input type="time" id="interviewTime" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Meeting Link (Zoom / Google Meet)</label>
                    <input type="url" id="meetingLink" class="form-control" placeholder="https://meet.google.com/abc-defg-hij" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveInterviewBtn">Schedule & Send Email</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const updateBtn = document.getElementById('updateStatusBtn');
        const statusDropdown = document.getElementById('statusDropdown');
        const notesInput = document.getElementById('notesInput');
        
        // Handle the main Update button click
        updateBtn.addEventListener('click', function () {
            const selectedStatus = statusDropdown.value;
            
            if (selectedStatus === 'Interview') {
                // Show the Modal
                var interviewModal = new bootstrap.Modal(document.getElementById('interviewModal'));
                interviewModal.show();
            } else {
                // Submit the hidden standard form
                document.getElementById('hiddenStatus').value = selectedStatus;
                document.getElementById('hiddenNotes').value = notesInput.value;
                document.getElementById('standardUpdateForm').submit();
            }
        });

        // Handle the Modal's "Save" button
        document.getElementById('saveInterviewBtn').addEventListener('click', function () {
            const date = document.getElementById('interviewDate').value;
            const time = document.getElementById('interviewTime').value;
            const link = document.getElementById('meetingLink').value;

            if (!date || !time) {
                alert('Please provide both Date and Time.');
                return;
            }

            const btn = this;
            btn.disabled = true;
            btn.innerText = 'Saving...';

            fetch('/Recruiter/ScheduleInterview', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({
                    applicationId: @Model.ApplicationId,
                    interviewDate: date,
                    interviewTime: time,
                    meetingLink: link
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    window.location.reload();
                } else {
                    alert('Failed to save. Error: ' + (data.message || 'Unknown'));
                    btn.disabled = false;
                    btn.innerText = 'Schedule & Send Email';
                }
            })
            .catch(error => {
                console.error(error);
                alert('An error occurred.');
                btn.disabled = false;
                btn.innerText = 'Schedule & Send Email';
            });
        });
    });
</script>