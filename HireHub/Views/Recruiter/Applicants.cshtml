@model HireHub.ViewModels.Applications.ApplicantsListViewModel
@{
    ViewData["Title"] = "Applicants";
    Layout = "_RecruiterLayout";
}

<!-- ====== HEADER ROW ====== -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h1 class="page-title mb-1">Applicants</h1>
        <p class="page-subtitle mb-0">Review candidates who applied to your jobs.</p>
    </div>

    <div class="d-flex gap-2 align-items-center">
        <!-- Export Button -->
        <a asp-action="ExportApplicants" asp-route-jobId="@Model.SelectedJobId" class="btn btn-success">
            <i class="bi bi-download"></i> Export CSV
        </a>

        <!-- Job Filter Form -->
        <form method="get" asp-action="Applicants" class="d-flex gap-2 mb-0">
            <input type="hidden" name="status" value="@Model.SelectedStatus" /> <!-- Keep status when changing job -->
            <select name="jobId" class="form-select" style="min-width: 200px;" onchange="this.form.submit()">
                <option value="">All Jobs</option>
                @foreach (var job in Model.RecruiterJobs)
                {
                    if (Model.SelectedJobId == job.JobId)
                    {
                        <option value="@job.JobId" selected>@job.Title</option>
                    }
                    else
                    {
                        <option value="@job.JobId">@job.Title</option>
                    }
                }
            </select>
            @if (Model.SelectedJobId.HasValue)
            {
                <a asp-action="Applicants" asp-route-status="@Model.SelectedStatus" class="btn btn-outline-secondary">Clear</a>
            }
        </form>
    </div>
</div>

<!-- ====== CLICKABLE STATS TABS ====== -->
<div class="row g-2 mb-4">
    <!-- Total -->
    <div class="col">
        <a asp-action="Applicants" asp-route-jobId="@Model.SelectedJobId" class="text-decoration-none">
            <div class="stat-card px-3 py-2 @(string.IsNullOrEmpty(Model.SelectedStatus) ? "bg-primary text-white shadow" : "bg-white")" style="transition: all 0.2s;">
                <div class="stat-icon @(string.IsNullOrEmpty(Model.SelectedStatus) ? "bg-white text-primary" : "bg-indigo")" style="width: 36px; height: 36px; font-size: 1rem; flex-shrink: 0;">
                    <i class="bi bi-people"></i>
                </div>
                <div class="ms-2 text-truncate">
                    <div class="stat-value @(string.IsNullOrEmpty(Model.SelectedStatus) ? "text-white" : "text-dark")" style="font-size: 1.2rem; line-height: 1.1;">@Model.TotalCount</div>
                    <div class="stat-label @(string.IsNullOrEmpty(Model.SelectedStatus) ? "text-white-50" : "text-muted")" style="font-size: 0.7rem;">Total</div>
                </div>
            </div>
        </a>
    </div>
    
    <!-- New -->
    <div class="col">
        <a asp-action="Applicants" asp-route-jobId="@Model.SelectedJobId" asp-route-status="Applied" class="text-decoration-none">
            <div class="stat-card px-3 py-2 @(Model.SelectedStatus == "Applied" ? "bg-info text-white shadow" : "bg-white")" style="transition: all 0.2s;">
                <div class="stat-icon @(Model.SelectedStatus == "Applied" ? "bg-white text-info" : "bg-blue")" style="width: 36px; height: 36px; font-size: 1rem; flex-shrink: 0;">
                    <i class="bi bi-inbox"></i>
                </div>
                <div class="ms-2 text-truncate">
                    <div class="stat-value @(Model.SelectedStatus == "Applied" ? "text-white" : "text-dark")" style="font-size: 1.2rem; line-height: 1.1;">@Model.AppliedCount</div>
                    <div class="stat-label @(Model.SelectedStatus == "Applied" ? "text-white-50" : "text-muted")" style="font-size: 0.7rem;">New</div>
                </div>
            </div>
        </a>
    </div>
    
    <!-- Shortlisted -->
    <div class="col">
        <a asp-action="Applicants" asp-route-jobId="@Model.SelectedJobId" asp-route-status="Shortlisted" class="text-decoration-none">
            <div class="stat-card px-3 py-2 @(Model.SelectedStatus == "Shortlisted" ? "bg-warning text-dark shadow" : "bg-white")" style="transition: all 0.2s;">
                <div class="stat-icon @(Model.SelectedStatus == "Shortlisted" ? "bg-white text-warning" : "bg-yellow")" style="width: 36px; height: 36px; font-size: 1rem; flex-shrink: 0;">
                    <i class="bi bi-star"></i>
                </div>
                <div class="ms-2 text-truncate">
                    <div class="stat-value text-dark" style="font-size: 1.2rem; line-height: 1.1;">@Model.ShortlistedCount</div>
                    <div class="stat-label @(Model.SelectedStatus == "Shortlisted" ? "text-dark-50" : "text-muted")" style="font-size: 0.7rem;">Shortlisted</div>
                </div>
            </div>
        </a>
    </div>
    
    <!-- Interview -->
    <div class="col">
        <a asp-action="Applicants" asp-route-jobId="@Model.SelectedJobId" asp-route-status="Interview" class="text-decoration-none">
            <div class="stat-card px-3 py-2 @(Model.SelectedStatus == "Interview" ? "bg-primary text-white shadow" : "bg-white")" style="transition: all 0.2s;">
                <div class="stat-icon @(Model.SelectedStatus == "Interview" ? "bg-white text-primary" : "bg-blue")" style="width: 36px; height: 36px; font-size: 1rem; flex-shrink: 0;">
                    <i class="bi bi-camera-video"></i>
                </div>
                <div class="ms-2 text-truncate">
                    <div class="stat-value @(Model.SelectedStatus == "Interview" ? "text-white" : "text-dark")" style="font-size: 1.2rem; line-height: 1.1;">@Model.InterviewCount</div>
                    <div class="stat-label @(Model.SelectedStatus == "Interview" ? "text-white-50" : "text-muted")" style="font-size: 0.7rem;">Interview</div>
                </div>
            </div>
        </a>
    </div>
    
    <!-- Hired -->
    <div class="col">
        <a asp-action="Applicants" asp-route-jobId="@Model.SelectedJobId" asp-route-status="Hired" class="text-decoration-none">
            <div class="stat-card px-3 py-2 @(Model.SelectedStatus == "Hired" ? "bg-success text-white shadow" : "bg-white")" style="transition: all 0.2s;">
                <div class="stat-icon @(Model.SelectedStatus == "Hired" ? "bg-white text-success" : "bg-green")" style="width: 36px; height: 36px; font-size: 1rem; flex-shrink: 0;">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div class="ms-2 text-truncate">
                    <div class="stat-value @(Model.SelectedStatus == "Hired" ? "text-white" : "text-dark")" style="font-size: 1.2rem; line-height: 1.1;">@Model.HiredCount</div>
                    <div class="stat-label @(Model.SelectedStatus == "Hired" ? "text-white-50" : "text-muted")" style="font-size: 0.7rem;">Hired</div>
                </div>
            </div>
        </a>
    </div>
    
    <!-- Rejected -->
    <div class="col">
        <a asp-action="Applicants" asp-route-jobId="@Model.SelectedJobId" asp-route-status="Rejected" class="text-decoration-none">
            <div class="stat-card px-3 py-2 @(Model.SelectedStatus == "Rejected" ? "bg-danger text-white shadow" : "bg-white")" style="transition: all 0.2s;">
                <div class="stat-icon @(Model.SelectedStatus == "Rejected" ? "bg-white text-danger" : "bg-red")" style="width: 36px; height: 36px; font-size: 1rem; flex-shrink: 0;">
                    <i class="bi bi-x-circle"></i>
                </div>
                <div class="ms-2 text-truncate">
                    <div class="stat-value @(Model.SelectedStatus == "Rejected" ? "text-white" : "text-dark")" style="font-size: 1.2rem; line-height: 1.1;">@Model.RejectedCount</div>
                    <div class="stat-label @(Model.SelectedStatus == "Rejected" ? "text-white-50" : "text-muted")" style="font-size: 0.7rem;">Rejected</div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- ====== TABLE ====== -->
<div class="section-card">
    @if (!Model.Applications.Any())
    {
        <div class="empty-state text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
            <p class="mt-3 text-muted">No applicants found for this filter.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr class="text-muted small">
                        <th>Candidate</th>
                        <th>Applied For</th>
                        <th class="hide-mobile">Location</th>
                        <th class="hide-mobile">Applied</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model.Applications)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@app.JobSeeker?.FullName</div>
                                <div class="small text-muted">@app.JobSeeker?.Email</div>
                            </td>
                            <td class="small">
                                <a asp-action="EditJob" asp-route-id="@app.JobId" class="text-decoration-none fw-semibold">
                                    @app.Job?.Title
                                </a>
                            </td>
                            <td class="small text-muted hide-mobile">@(app.JobSeeker?.JobSeekerProfile?.Location ?? "—")</td>
                            <td class="small text-muted hide-mobile">@app.AppliedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="badge-soft @app.Status.ToLower()">@app.Status</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="ApplicantDetails" asp-route-id="@app.ApplicationId"
                                   class="btn btn-sm btn-outline-primary" title="View Application">
                                    <i class="bi bi-eye"></i> View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>