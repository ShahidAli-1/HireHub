@model HireHub.ViewModels.Auth.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
    Layout = "_LoginLayout";
}

<h3 class="fw-bold mb-2 text-dark">Create an Account</h3>
<p class="text-muted mb-4">Join thousands of professionals today.</p>

<form asp-action="Register" method="post" id="registerForm">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 py-2 small"></div>

    <!-- Role Selector Toggle -->
    <div class="mb-4">
        <label class="form-label fw-semibold">I want to join as</label>
        <div class="d-flex gap-2 bg-light p-1 rounded-3 border">
            <input type="radio" class="btn-check" asp-for="Role" value="JobSeeker" id="roleSeeker" checked>
            <label class="btn btn-outline-primary border-0 w-50 rounded-2 fw-semibold" for="roleSeeker">
                <i class="bi bi-person-badge"></i> Job Seeker
            </label>

            <input type="radio" class="btn-check" asp-for="Role" value="Recruiter" id="roleRecruiter">
            <label class="btn btn-outline-primary border-0 w-50 rounded-2 fw-semibold" for="roleRecruiter">
                <i class="bi bi-briefcase"></i> Recruiter
            </label>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="FullName" class="form-label fw-semibold">Full Name</label>
        <input asp-for="FullName" class="form-control" placeholder="e.g. Ali Hamza" />
        <span asp-validation-for="FullName" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
        <input asp-for="Email" class="form-control" placeholder="you@example.com" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label fw-semibold">Password</label>
        <input asp-for="Password" type="password" class="form-control" placeholder="Minimum 6 characters" />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm Password</label>
        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Re-enter password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>

    <button type="submit" class="mb-4 fs-5 d-flex justify-content-center align-items-center gap-2">
        <i class="bi bi-rocket-takeoff"></i> Create Account
    </button>

    <div class="text-center">
        <p class="small text-muted mb-0">Already have an account? <a asp-action="Login" class="fw-bold text-primary text-decoration-none">Log in</a></p>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show CompanyName field when Recruiter is selected (if you add it back later)
        document.querySelectorAll('input[name="Role"]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                var btnSeeker = document.getElementById('roleSeeker');
                var btnRecruiter = document.getElementById('roleRecruiter');
                
                if (this.value === 'Recruiter') {
                    btnRecruiter.classList.add('btn-primary', 'text-white');
                    btnRecruiter.classList.remove('btn-outline-primary');
                    btnSeeker.classList.remove('btn-primary', 'text-white');
                    btnSeeker.classList.add('btn-outline-primary');
                } else {
                    btnSeeker.classList.add('btn-primary', 'text-white');
                    btnSeeker.classList.remove('btn-outline-primary');
                    btnRecruiter.classList.remove('btn-primary', 'text-white');
                    btnRecruiter.classList.add('btn-outline-primary');
                }
            });
        });
        
        // Trigger on load
        document.getElementById('roleSeeker').dispatchEvent(new Event('change'));
    </script>
}